package tour;

import cajeta.lang.String;

/**
 * The cajeta-logging tour — one self-checking demo per topic:
 *
 *   FacadeDemo     Log.console, level methods, fielded records, enabled()
 *   LevelsDemo     the six-value vocabulary, severity ranks, OFF
 *   EncodersDemo   one record as JSONL, text, and logfmt
 *   AppendersDemo  file lifecycle (APPEND/WRITE/close), console+file fan-out
 *   ExtensionDemo  a custom LogEncoder and Appender over LogField
 *
 * These demos construct their encoders and appenders explicitly, so they
 * behave identically against the published `.cja` (this manifest's build)
 * and a from-source compile. The `@Logged`/DI service scenario needs the
 * library SOURCES in the same compile (compile-time DI resolves in the
 * final binary), so it lives in `../../src-di` and only runs via `run.sh`.
 *
 * Demos print real log lines (narration) and assert through capturing
 * sinks (verification); the exit code is the number of failed checks.
 */
public final class LoggingTour {

    /** The shared demo list — run by both entry points. */
    public static void sections() {
        FacadeDemo facade = heap FacadeDemo();
        facade.execute();

        LevelsDemo levels = heap LevelsDemo();
        levels.execute();

        EncodersDemo encoders = heap EncodersDemo();
        encoders.execute();

        AppendersDemo appenders = heap AppendersDemo();
        appenders.execute();

        ExtensionDemo extension = heap ExtensionDemo();
        extension.execute();
    }

    /** The manifest entry (published .cja): everything except the DI half. */
    public static int32 main(String[] args) {
        System.stdout.println("=== cajeta-logging tour ===");
        LoggingTour.sections();
        System.stdout.println("");
        System.stdout.println("=== @Logged + DI service scenario: needs a from-source compile — run ./run.sh ===");
        System.stdout.println("=== tour: " + DemoClass.checks + " checks, "
            + DemoClass.failures + " failures ===");
        return DemoClass.failures;
    }
}
