package dev.cajeta.logging.selftest;

import dev.cajeta.unit.Assert;
import dev.cajeta.logging.Logger;
import dev.cajeta.logging.Level;
import dev.cajeta.logging.LogRecord;
import dev.cajeta.logging.LoggerFactory;
import dev.cajeta.logging.CapturingAppender;

/**
 * Facade tests over the DI-wired logger. Under `--profile=test` the
 * `LoggerFactory` injects the `JsonlEncoder` + the masking `CapturingAppender`,
 * so a factory-produced logger writes JSONL into the captured sink. Counts are
 * read as deltas because the appender is a process singleton shared across
 * tests. (Sinks are NOT lent from a local — that field-store-of-borrow is
 * unsound at v1; DI singletons are the sound shared-sink path.)
 */
public class LoggingTest {

    public LoggingTest() {
        return;
    }

    @Test
    public void infoLineIsCapturedAsJsonl() {
        CapturingAppender cap = CapturingAppender.__cajeta_inject();
        int32 before = cap.count();
        Logger log #= LoggerFactory.__cajeta_inject().loggerFor("svc", Level.INFO);
        log.info("service started");
        Assert.that(cap.count()).isEqualTo(before + 1);
        String line = cap.get(cap.count() - 1);
        Assert.that(line).contains("\"level\":\"INFO\"");
        Assert.that(line).contains("\"logger\":\"svc\"");
        Assert.that(line).contains("\"msg\":\"service started\"");
        return;
    }

    @Test
    public void belowThresholdIsGatedOut() {
        CapturingAppender cap = CapturingAppender.__cajeta_inject();
        int32 before = cap.count();
        Logger log #= LoggerFactory.__cajeta_inject().loggerFor("svc", Level.WARN);
        log.info("not severe enough");
        Assert.that(cap.count()).isEqualTo(before);
        log.warn("now we are talking");
        Assert.that(cap.count()).isEqualTo(before + 1);
        return;
    }

    @Test
    public void fieldsRenderAfterReservedKeys() {
        CapturingAppender cap = CapturingAppender.__cajeta_inject();
        int32 before = cap.count();
        Logger log #= LoggerFactory.__cajeta_inject().loggerFor("svc", Level.INFO);
        LogRecord r #= log.event(Level.WARN, "slow request");
        r.str("route", "/checkout");
        r.i64("ms", 1200);
        r.flag("retried", true);
        log.emit(#r);
        Assert.that(cap.count()).isEqualTo(before + 1);
        String line = cap.get(cap.count() - 1);
        Assert.that(line).contains("\"route\":\"/checkout\"");
        Assert.that(line).contains("\"ms\":1200");
        Assert.that(line).contains("\"retried\":true");
        return;
    }
}
