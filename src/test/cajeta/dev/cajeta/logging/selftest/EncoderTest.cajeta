package dev.cajeta.logging.selftest;

import dev.cajeta.unit.Assert;
import dev.cajeta.logging.Level;
import dev.cajeta.logging.LogRecord;
import dev.cajeta.logging.TextEncoder;
import dev.cajeta.logging.LogfmtEncoder;

/**
 * Phase 2 output-format tests: TextEncoder + LogfmtEncoder. Each builds a
 * LogRecord and calls `encode` DIRECTLY (no Logger / appender), then asserts on
 * the rendered line's shape, level rendering, field tail, and value
 * quoting/escaping. Direct encoding keeps ownership simple — the record is a
 * plain local, the encoder borrows it, the returned bytes become a String.
 */
public class EncoderTest {

    public EncoderTest() {
        return;
    }

    // Render `record` through `enc` and return the line as a String.
    static #String render(TextEncoder enc, LogRecord rec) {
        int8[] bytes #= enc.encode(rec);
        int32 n = (int32) bytes.count();
        return heap String(#bytes, n);
    }

    static #String renderLogfmt(LogfmtEncoder enc, LogRecord rec) {
        int8[] bytes #= enc.encode(rec);
        int32 n = (int32) bytes.count();
        return heap String(#bytes, n);
    }

    // ---- TextEncoder -----------------------------------------------------

    @Test
    public void textRendersLevelLoggerMsgAndFields() {
        LogRecord r = heap LogRecord(0, Level.INFO, "order", "order placed");
        r.str("id", "o_42").i64("amount", 1999);
        TextEncoder enc = heap TextEncoder();
        String line #= EncoderTest.render(enc, r);
        Assert.that(line).contains("INFO ");          // padded to width 5
        Assert.that(line).contains("order placed");    // msg emitted raw
        Assert.that(line).contains("id=o_42");
        Assert.that(line).contains("amount=1999");
        return;
    }

    @Test
    public void textQuotesFieldValuesWithSpaces() {
        LogRecord r = heap LogRecord(0, Level.WARN, "svc", "slow");
        r.str("note", "needs review");
        TextEncoder enc = heap TextEncoder();
        String line #= EncoderTest.render(enc, r);
        Assert.that(line).contains("note=\"needs review\"");
        return;
    }

    @Test
    public void textPadsShortLevels() {
        LogRecord r = heap LogRecord(0, Level.WARN, "svc", "hi");
        TextEncoder enc = heap TextEncoder();
        String line #= EncoderTest.render(enc, r);
        // WARN (4) pads to "WARN " then a single separator space → "WARN  ".
        Assert.that(line).contains("WARN  ");
        return;
    }

    // ---- LogfmtEncoder ---------------------------------------------------

    @Test
    public void logfmtRendersReservedKeysThenFields() {
        LogRecord r = heap LogRecord(0, Level.WARN, "order", "order placed");
        r.str("id", "o_42").flag("ok", true);
        LogfmtEncoder enc = heap LogfmtEncoder();
        String line #= EncoderTest.renderLogfmt(enc, r);
        Assert.that(line).startsWith("ts=");
        Assert.that(line).contains("level=warn");           // lower-cased
        Assert.that(line).contains("logger=order");
        Assert.that(line).contains("msg=\"order placed\"");  // quoted (space)
        Assert.that(line).contains("id=o_42");
        Assert.that(line).contains("ok=true");
        return;
    }

    @Test
    public void logfmtEscapesQuotesInValues() {
        LogRecord r = heap LogRecord(0, Level.INFO, "svc", "m");
        r.str("path", "a\"b");
        LogfmtEncoder enc = heap LogfmtEncoder();
        String line #= EncoderTest.renderLogfmt(enc, r);
        // value a"b → quoted + escaped: path="a\"b"
        Assert.that(line).contains("path=\"a\\\"b\"");
        return;
    }
}
