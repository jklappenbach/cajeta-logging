package dev.cajeta.logging;

/**
 * Entry facade for cajeta-logging. Tier-1 factories that wire a `Logger` to an
 * encoder + appender with no DI container (DI wiring is Phase 3). See
 * `docs/logging-spec.md` for the full design and `plan/logging-plan.md` for the
 * roadmap (Tier 2 adds ambient context over `cajeta.concurrent.FiberLocal`).
 */
public final class Log {

    /** A logger that emits compact JSONL to stdout at/above `threshold`. */
    public static #Logger console(String name, Level threshold) {
        return heap Logger(name, threshold, heap JsonlEncoder(), heap ConsoleAppender());
    }

    /**
     * The default logger for a `@Logged`-annotated class. The compiler
     * synthesizes `static Logger log = Log.defaultFor("pkg.Class")` into any
     * such class, so this is the out-of-the-box configuration — now DI-wired:
     * it routes through the singleton `LoggerFactory`, so the encoder + appender
     * are the profile-selected ones (prod→JSONL/file, dev→text/console,
     * test→capturing) and the logger borrows those shared sinks.
     */
    public static #Logger defaultFor(String name) {
        return Log.at(name, Level.INFO);
    }

    /**
     * A logger named `name` gated at `threshold`, sharing the process's DI
     * sinks — the same encoder and appender behind every other logger.
     *
     * This is `defaultFor` without the INFO assumption, and it exists so
     * that streams AGGREGATE. `console` builds a FRESH `ConsoleAppender`
     * per call, so two components each calling it get two independent
     * appenders that merely happen to both reach the console; configure a
     * file sink later and only one of them follows. Anything wanting its
     * records merged into the host application's single stream has to come
     * through the factory.
     *
     * Diagnostics are the motivating case and they sit BELOW info: the
     * cajeta-llm engine's `DiagSink` lines are DEBUG route-selection
     * detail, and cabra aggregates them with its own logs rather than
     * running a second stream beside them (Julian, 2026-08-30).
     */
    public static #Logger at(String name, Level threshold) {
        return LoggerFactory.__cajeta_inject().loggerFor(name, threshold);
    }

    /** A logger that captures encoded lines in-memory (for tests). */
    public static #Logger capturing(String name, Level threshold, #CapturingAppender sink) {
        return heap Logger(name, threshold, heap JsonlEncoder(), #sink);
    }

    /**
     * Smoke demo for `cajeta jit-run dev.cajeta.logging.Log.demo`: emits two
     * JSONL lines to stdout (an INFO with no fields, a WARN with three fields)
     * and verifies the DEBUG line is gated out.
     */
    public static void demo() {
        Logger log #= Log.console("demo", Level.INFO);

        log.info("service started");

        LogRecord r #= log.event(Level.WARN, "slow request");
        r.str("route", "/checkout").i64("ms", 1200).flag("retried", true);
        log.emit(#r);

        log.debug("below threshold — should not appear");
    }

    /**
     * Native entry shim (`--emit=exe dev.cajeta.logging.Log.run`): runs the
     * demo, exits 0. A standalone smoke point while `jit-run` is blocked here by
     * the reflection-thunk env gap.
     */
    public static int32 run() {
        Log.demo();
        return 0;
    }
}
