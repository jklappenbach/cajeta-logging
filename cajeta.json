{
    // cajeta-logging — structured logging for the Cajeta ecosystem: levels,
    // appenders (console/file/capturing), patterns, and a compile-time-DI
    // LoggerFactory (@Profile-selected providers).
    //
    // A LIBRARY project: no `entry-method`, so the build emits a reusable `.cja`
    // rather than an executable.
    //
    // VERSIONING — `details.version` is the SINGLE source of truth. It names the
    // built archive (`dev.cajeta.logging-<version>.cja`), it is what CI publishes
    // to Olla, and CI asserts a `v*` tag agrees with it. No VERSION file.

    "details": {
        "name":               "dev.cajeta.logging",
        "version":            "0.7.0",
        "description":        "cajeta-logging — levels, appenders, patterns, DI-wired LoggerFactory",
        "license":            "Apache-2.0",
        "authors":            ["Julian Klappenbach"],
        "cajeta-lang-version": "1.0"
    },

    "settings": {
        // Declare only what the library's public API actually needs. A
        // pure-computation library may need none at all; capabilities are
        // re-validated against the consumer's manifest at the point of use.
        // `filesystem`: FileAppender writes log lines through cajeta.io.file.
        "capabilities": ["filesystem"],

        // Third-party runtime dependencies. The core stdlib (cajeta.lang,
        // cajeta.io, cajeta.codec, …) is built into the toolchain — neither
        // declared nor fetched — and only the parts your code uses are linked
        // into a consumer's binary (dead-code elimination).
        "dependencies": {},

        // Test-only dependencies — not shipped in the published .cja.
        // dev.cajeta.unit drives the suite (reflective @Test discovery); the
        // starter's `cajeta.testkit` placeholder named a package that exists in
        // no repository and is gone.
        "dev-dependencies": {
            "dev.cajeta.unit": "0.2.0"
        },

        "repositories": [
            // olla.cajeta.dev — repo.cajeta.org (the starter default) is NXDOMAIN.
            { "name": "central", "url": "https://olla.cajeta.dev",
              "priority": 0 }
        ],

        // NO `entry-method` here — that is what makes this a library. With an
        // entry point the build emits an exe; without one it emits a .cja.
        "build": {
            "target": "host"
        }
    },

    "tasks": {

        "build": {
            "description": "Compile sources to a .cja library archive",
            "actions": [
                { "action": "build", "flavor": "debug", "id": "art" }
            ],
            "outputs": { "path": "${art.path}", "sha256": "${art.sha256}" }
        },

        "test": {
            // Delegates to ./run-tests.sh: the suite must be compiled TOGETHER
            // with the library sources under --profile=test so the DI graph
            // (@Profile providers, @TestComponent CapturingAppender) resolves in
            // the final binary — and the script owns the cajeta-unit resolution
            // (checkout → $OLLA_HOME → registry fetch). The starter's inline
            // action pair here built the library alone and "tested" a .cja with
            // no tests in it.
            "description": "Build + run the library's unit tests",
            "actions": [
                { "action": "exec", "command": "./run-tests.sh" }
            ]
        },

        "release": {
            "description": "Optimized release build of the library (.cja)",
            "actions": [
                { "action": "build", "flavor": "release", "id": "art" }
            ],
            "outputs": { "path": "${art.path}", "sha256": "${art.sha256}" }
        },

        "clean": {
            "description": "Wipe build outputs",
            "actions": [ { "action": "clean" } ]
        }
    }
}
